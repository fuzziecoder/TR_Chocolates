{%- liquid
  assign collection = collections[section.settings.collection]
  assign product_limit = section.settings.products_to_show | default: 4
-%}

<section class="section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-header-row">
      <div>
        {%- if section.settings.subheading != blank -%}
          <span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); display: block; margin-bottom: 0.5rem;">
            {{ section.settings.subheading | escape }}
          </span>
        {%- endif -%}
        <h2 class="section-title">
          {{ section.settings.heading | default: collection.title | default: 'Featured Creations' }}
        </h2>
      </div>

      {%- if section.settings.show_view_all and collection.url != blank -%}
        <a href="{{ collection.url }}" class="btn btn--secondary" style="padding: 0.65rem 1.4rem;">
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="products-grid">
        {%- for product in collection.products limit: product_limit -%}
          {% render 'product-card',
            product: product,
            show_vendor: section.settings.show_vendor,
            show_quick_add: section.settings.show_quick_add
          %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">
        <h3>{{ 'collections.general.empty' | t }}</h3>
        <p style="color: var(--color-text-secondary); margin-top: 0.5rem;">
          Select a collection with products in the Theme Editor to showcase them here.
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Small-Batch Chocolates"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hand-Poured & Slow-Tempered"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Enable quick add button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
