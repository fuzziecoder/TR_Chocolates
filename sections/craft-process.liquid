{%- if section.settings.show_section -%}
  <section class="section-spacing" data-section-id="{{ section.id }}">
    <div class="page-width">
      <div style="text-align: center; max-width: 640px; margin: 0 auto 3rem;">
        {%- if section.settings.subheading != blank -%}
          <span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); display: block; margin-bottom: 0.5rem;">
            {{ section.settings.subheading | escape }}
          </span>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.description != blank -%}
          <p style="color: var(--color-text-secondary); margin-top: 0.75rem;">
            {{ section.settings.description | escape }}
          </p>
        {%- endif -%}
      </div>

      <div class="craft-process-grid">
        {%- for block in section.blocks -%}
          <div class="craft-step-card" {{ block.shopify_attributes }}>
            <div class="craft-step-num">0{{ forloop.index }}</div>
            <h3 class="craft-step-title">{{ block.settings.title | escape }}</h3>
            <p class="craft-step-desc">{{ block.settings.text | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Craft & Process",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show Craft & Process Section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Handcrafted Method"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From Seed to Small Batch"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Committed to uncompromised botanical integrity and traditional culinary patience."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Craft Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Traceable Origin"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step Description",
          "default": "Directly partnering with smallholder growers dedicated to organic agroforestry and sustainable harvests."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craft & Process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Ethical Sourcing",
            "text": "Selecting raw cacao and native botanical herbs harvested in harmony with regional ecosystems."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Stone-Ground Patience",
            "text": "Refining cacao and medicinal herbs using traditional low-temperature stone mills to preserve volatile notes."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Artisanal Purity",
            "text": "Poured, tempered, and packaged by hand with zero synthetic stabilizers, artificial colors, or fillers."
          }
        }
      ]
    }
  ]
}
{% endschema %}
