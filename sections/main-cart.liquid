<div class="page-width section-spacing" data-section-id="{{ section.id }}">
  <h1 style="font-size: 2.75rem; margin-bottom: 2rem;">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form">
      <div class="cart-table-wrapper">
        <table class="cart-table">
          <thead>
            <tr>
              <th>{{ 'cart.headings.product' | t }}</th>
              <th>{{ 'cart.headings.price' | t }}</th>
              <th style="text-align: center;">{{ 'cart.headings.quantity' | t }}</th>
              <th style="text-align: right;">{{ 'cart.headings.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="cart-item-flex">
                    <div class="cart-item-thumb">
                      {%- if item.image != blank -%}
                        {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.title | escape }}
                      {%- else -%}
                        <div style="background: #EFE8DC; width: 100%; height: 100%;"></div>
                      {%- endif -%}
                    </div>
                    <div>
                      <a href="{{ item.url }}" style="font-family: var(--font-heading); font-size: 1.15rem; font-weight: 700;">
                        {{ item.product.title }}
                      </a>
                      {%- unless item.product.has_only_default_variant -%}
                        <div style="font-size: 0.85rem; color: var(--color-text-secondary); margin-top: 0.25rem;">
                          {{ item.variant.title }}
                        </div>
                      {%- endunless -%}
                      <div style="margin-top: 0.5rem;">
                        <a
                          href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                          style="font-size: 0.8rem; color: #B25342; text-decoration: underline;"
                        >
                          {{ 'cart.remove' | t }}
                        </a>
                      </div>
                    </div>
                  </div>
                </td>

                <td style="font-weight: 600;">
                  {{ item.price | money }}
                </td>

                <td style="text-align: center;">
                  <div class="quantity-stepper" style="margin-bottom: 0;">
                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                      class="quantity-btn"
                      aria-label="{{ 'products.product.quantity_decrease' | t }}"
                    >&minus;</a>
                    <input
                      type="number"
                      name="updates[]"
                      id="updates_{{ item.key }}"
                      value="{{ item.quantity }}"
                      min="0"
                      class="quantity-input"
                      aria-label="{{ 'cart.headings.quantity' | t }}"
                    >
                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                      class="quantity-btn"
                      aria-label="{{ 'products.product.quantity_increase' | t }}"
                    >&plus;</a>
                  </div>
                </td>

                <td style="text-align: right; font-weight: 700; font-size: 1.1rem;">
                  {{ item.final_line_price | money }}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;">
        <div style="display: flex; flex-direction: column; md:flex-row; justify-content: space-between; gap: 2rem;">
          <div style="max-width: 460px;">
            <label for="CartSpecialInstructions" style="display: block; font-weight: 700; font-size: 0.95rem; margin-bottom: 0.5rem;">
              {{ 'cart.note' | t }}
            </label>
            <textarea
              name="note"
              id="CartSpecialInstructions"
              rows="4"
              style="width: 100%; border: 2px solid var(--color-borders); border-radius: var(--button-radius); padding: 0.75rem; font-size: 0.95rem; background: #FFF;"
              placeholder="Add an artisan note or special packaging request..."
            >{{ cart.note }}</textarea>
          </div>

          <div class="cart-summary-box">
            <div class="cart-summary-row">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span class="cart-subtotal">{{ cart.total_price | money_with_currency }}</span>
            </div>

            <p style="color: var(--color-text-secondary); font-size: 0.85rem; margin-bottom: 1.5rem;">
              {{ 'cart.shipping_at_checkout' | t }}
            </p>

            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <button type="submit" name="checkout" class="btn btn--primary btn--full" style="padding: 1.1rem;">
                {{ 'cart.checkout' | t }}
              </button>

              <button type="submit" name="update" class="btn btn--secondary btn--full">
                {{ 'cart.update' | t }}
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  {%- else -%}
    <div class="empty-state">
      <h2>{{ 'cart.empty' | t }}</h2>
      <p style="color: var(--color-text-secondary); margin: 1rem 0 2rem;">
        Discover single-origin chocolates, pantry staples, and authentic botanical care.
      </p>
      <a href="/collections" class="btn btn--primary">
        {{ 'cart.continue_browsing' | t }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
