<section class="hero-section section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="hero-grid">
      <div class="hero-content">
        {%- if section.settings.badge_text != blank -%}
          <span class="hero-tagline">{{ section.settings.badge_text | escape }}</span>
        {%- endif -%}

        <h1 class="hero-heading">{{ section.settings.heading | escape }}</h1>

        {%- if section.settings.subheading != blank -%}
          <p class="hero-subtext">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        <div class="hero-cta-group">
          {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
            <a href="{{ section.settings.button_link }}" class="btn btn--primary">
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank -%}
            <a href="{{ section.settings.secondary_button_link }}" class="btn btn--secondary">
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="hero-media-wrapper">
        <div class="hero-image-card">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                sizes: '(min-width: 992px) 50vw, 100vw',
                widths: '360, 540, 720, 900, 1200',
                alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          {%- else -%}
            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #ECE3D4; min-height: 380px;">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-accent); opacity: 0.7;">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                <circle cx="9" cy="9" r="2"/>
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
              </svg>
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.floating_badge != blank -%}
          <div class="hero-badge-starburst" aria-hidden="true">
            <span>{{ section.settings.floating_badge | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Tagline / Badge",
      "default": "Small-Batch Handcrafted"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pure Artisan Chocolate & Heritage Botanical Care"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Handcrafted single-origin chocolate bars, wholesome pantry essentials, and time-honored traditional herbal formulations crafted for mindful living."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Explore Chocolate"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link",
      "default": "/collections/chocolate"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "Herbal & Care"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link",
      "default": "/collections/herbal-traditional-care"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "floating_badge",
      "label": "Floating Starburst Badge",
      "default": "Pure Batch"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
