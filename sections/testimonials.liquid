{%- if section.settings.show_section and section.blocks.size > 0 -%}
  <section class="section-spacing" data-section-id="{{ section.id }}">
    <div class="page-width">
      <div style="text-align: center; max-width: 640px; margin: 0 auto;">
        {%- if section.settings.subheading != blank -%}
          <span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); display: block; margin-bottom: 0.5rem;">
            {{ section.settings.subheading | escape }}
          </span>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      </div>

      <div class="testimonials-grid">
        {%- for block in section.blocks -%}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-stars" aria-label="5 out of 5 stars">
              {%- for i in (1..5) -%}
                {% render 'icon', name: 'star' %}
              {%- endfor -%}
            </div>
            <p class="testimonial-quote">&ldquo;{{ block.settings.quote | escape }}&rdquo;</p>
            <span class="testimonial-author">&mdash; {{ block.settings.author | escape }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials & Press",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show Testimonials Section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Words From Our Community"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Artisan Appreciation"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Approved Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote / Testimonial Text",
          "default": "The nuance of the stone-ground chocolate and the botanical purity of their traditional care formulations are unparalleled."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author or Publication",
          "default": "Artisan Culinary Journal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials & Press",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "A truly rare harmony of ethical single-origin cacao and ancient herbal self-care.",
            "author": "Heritage Food & Living"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Uncompromising purity in every bar and formulation. You can taste and feel the mindful handcrafting.",
            "author": "Mindful Living Guild"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Their dedication to authentic botanical traditions and slow-batch confectionery sets a standard.",
            "author": "Artisan Confectionery Review"
          }
        }
      ]
    }
  ]
}
{% endschema %}
