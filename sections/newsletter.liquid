<section class="newsletter-section section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="newsletter-box">
      <h2 style="font-size: 2.25rem; margin-bottom: 0.75rem;">
        {{ section.settings.heading | default: 'sections.newsletter.heading' | t }}
      </h2>

      {%- if section.settings.subtext != blank -%}
        <p style="color: var(--color-text-secondary); font-size: 1.05rem;">
          {{ section.settings.subtext | escape }}
        </p>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          <div class="newsletter-success" role="status">
            {{ 'sections.newsletter.success' | t }}
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div style="color: #B25342; font-weight: 600; width: 100%; margin-bottom: 0.5rem;" role="alert">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}

          <input
            type="email"
            name="contact[email]"
            class="newsletter-input"
            value="{{ form.email }}"
            placeholder="{{ 'sections.newsletter.email_placeholder' | t }}"
            aria-label="{{ 'sections.newsletter.email_placeholder' | t }}"
            required
            autocomplete="email"
          >

          <button type="submit" class="btn btn--primary" style="white-space: nowrap;">
            {{ section.settings.button_label | default: 'sections.newsletter.button_label' | t }}
          </button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join Our Artisan Circle"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Receive quiet notes on small-batch harvests, seasonal chocolate batches, and traditional herbal formulations."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
