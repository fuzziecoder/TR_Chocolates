<div class="page-width section-spacing" data-section-id="{{ section.id }}">
  {% render 'breadcrumbs' %}

  <div style="max-width: 860px; margin: 0 auto;">
    <h1 style="font-size: 3rem; margin-bottom: 2rem; text-align: center;">{{ page.title }}</h1>

    <div class="rte" style="font-size: 1.1rem; line-height: 1.75; color: var(--color-text-primary);">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
