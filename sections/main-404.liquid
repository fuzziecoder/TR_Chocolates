<div class="page-width section-spacing" data-section-id="{{ section.id }}">
  <div style="text-align: center; max-width: 600px; margin: 4rem auto;">
    <div style="font-family: var(--font-heading); font-size: 5rem; font-weight: 900; color: var(--color-accent); line-height: 1; margin-bottom: 1rem;">
      404
    </div>
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">{{ 'general.404.title' | t }}</h1>
    <p style="color: var(--color-text-secondary); font-size: 1.15rem; margin-bottom: 2.5rem;">
      {{ 'general.404.subtext' | t }}
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="{{ routes.root_url }}" class="btn btn--primary">
        {{ 'general.404.button_home' | t }}
      </a>
      <a href="/collections" class="btn btn--secondary">
        {{ 'general.404.button_shop' | t }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 Not Found",
  "settings": []
}
{% endschema %}
