<footer class="site-footer" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="footer-grid">
      {%- comment -%} Brand Bio Column {%- endcomment -%}
      <div>
        <h3 class="footer-col__title">{{ section.settings.brand_heading | default: shop.name }}</h3>
        <p style="color: #CFC5BE; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
          {{ section.settings.brand_bio | escape }}
        </p>

        <div class="footer-social-icons">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="social-icon-btn" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="social-icon-btn" aria-label="Facebook" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}" class="social-icon-btn" aria-label="Pinterest" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="9" x2="12" y2="22"/><path d="M8 12c-1.5 0-3-1.5-3-4a6 6 0 0 1 12 0c0 4-3 7-5 7"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" class="social-icon-btn" aria-label="YouTube" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><polygon points="10 15 15 12 10 9 10 15"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Menu Column 1: Shop Collections {%- endcomment -%}
      <div>
        <h4 class="footer-col__title">Collections</h4>
        <ul class="footer-links">
          <li><a href="/collections/chocolate">Chocolate</a></li>
          <li><a href="/collections/pantry">Pantry</a></li>
          <li><a href="/collections/herbal-traditional-care">Herbal & Traditional Care</a></li>
          <li><a href="/collections/bath-body">Bath & Body</a></li>
          <li><a href="/collections/face-care">Face Care</a></li>
          <li><a href="/collections/hair-care">Hair Care</a></li>
        </ul>
      </div>

      {%- comment -%} Menu Column 2: Navigation / Story {%- endcomment -%}
      <div>
        <h4 class="footer-col__title">{{ section.settings.menu_title | default: 'About' }}</h4>
        {%- assign footer_menu = linklists[section.settings.menu] | default: linklists.footer -%}
        <ul class="footer-links">
          {%- if footer_menu.links.size > 0 -%}
            {%- for link in footer_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.root_url }}">Home</a></li>
            <li><a href="/pages/our-story">Our Story</a></li>
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="/pages/faqs">FAQs</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Information / Policies Column {%- endcomment -%}
      <div>
        <h4 class="footer-col__title">Client Care</h4>
        <ul class="footer-links">
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/shipping-policy">Shipping & Delivery</a></li>
          <li><a href="/policies/refund-policy">Refund Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Handcrafted with Devotion.
      </div>

      <div>
        {{ powered_by_link }}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Brand Heading",
      "default": "TR Artisan Reserve"
    },
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Brand Bio",
      "default": "Dedicated to artisanal single-origin chocolate, pure pantry staples, and authentic traditional herbal wellness formulations."
    },
    {
      "type": "text",
      "id": "menu_title",
      "label": "Menu 2 Title",
      "default": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu",
      "default": "footer"
    }
  ]
}
{% endschema %}
