<section class="brand-story section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="brand-story-grid">
      <div class="brand-story__content">
        {%- if section.settings.tagline != blank -%}
          <span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); display: block; margin-bottom: 0.75rem;">
            {{ section.settings.tagline | escape }}
          </span>
        {%- endif -%}

        <h2>{{ section.settings.heading | escape }}</h2>

        <div style="margin-bottom: 2rem;">
          {{ section.settings.story_text }}
        </div>

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--primary">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <div class="brand-story__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 992px) 50vw, 100vw',
              widths: '360, 540, 720, 1000',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #351F14; min-height: 340px;">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-accent); opacity: 0.8;">
              <path d="M12 21a9 9 0 0 0 9-9c0-4.97-4.03-9-9-9s-9 4.03-9 9a9 9 0 0 0 9 9Z"/>
              <path d="M12 7v5l3 3"/>
            </svg>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Our Philosophy & Lineage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Honoring the Earth through Mindful Craft"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Text",
      "default": "<p>Every bar of single-origin chocolate begins with pure, ethically tended beans, stone-ground with patience. Alongside our confectionery, our traditional care formulations draw upon centuries of botanical heritage—harnessing pure botanicals, cold-pressed oils, and unadulterated roots.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read Our Full Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/pages/our-story"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
