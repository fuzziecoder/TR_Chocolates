{%- if section.settings.enable_section and section.settings.heading != blank -%}
  <section class="section-spacing" data-section-id="{{ section.id }}">
    <div class="page-width">
      <div class="seasonal-banner">
        <div>
          {%- if section.settings.tagline != blank -%}
            <span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); display: block; margin-bottom: 0.5rem;">
              {{ section.settings.tagline | escape }}
            </span>
          {%- endif -%}

          <h2>{{ section.settings.heading | escape }}</h2>

          {%- if section.settings.description != blank -%}
            <p>{{ section.settings.description | escape }}</p>
          {%- endif -%}

          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
              <a href="{{ section.settings.button_link }}" class="btn btn--primary">
                {{ section.settings.button_label | escape }}
              </a>
            {%- endif -%}

            {%- if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank -%}
              <a href="{{ section.settings.secondary_button_link }}" class="btn btn--secondary" style="color: #F8F5EE; border-color: #F8F5EE;">
                {{ section.settings.secondary_button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>

        <div style="border-radius: 16px; overflow: hidden; border: 2px solid rgba(248, 245, 238, 0.2); aspect-ratio: 4/3; background: #2A170C;">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 992px) 40vw, 100vw',
                widths: '300, 500, 800',
                alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          {%- else -%}
            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C86A58" stroke-width="1.5">
                <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
              </svg>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Seasonal & Gift Feature",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Limited Reserve"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Artisan Festive & Gift Pairings"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Curated selections uniting our stone-ground chocolate reserves with traditional herbal elixirs, packaged in keepsake artisan presentation boxes."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "View Gift Sets"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link",
      "default": "/collections/pantry"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "Custom Inquiries"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link",
      "default": "/pages/contact"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature Image"
    }
  ],
  "presets": [
    {
      "name": "Seasonal & Gift Feature"
    }
  ]
}
{% endschema %}
