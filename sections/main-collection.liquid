{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="page-width section-spacing" data-section-id="{{ section.id }}">
    {% render 'breadcrumbs' %}

    {%- comment -%} Collection Banner {%- endcomment -%}
    <div class="collection-banner">
      <h1 class="collection-banner__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-banner__desc">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>

    <div class="collection-layout">
      {%- comment -%} Facet Filters Sidebar {%- endcomment -%}
      <aside class="filters-sidebar" aria-label="Collection Filters">
        <form data-filter-form method="get" action="{{ collection.url }}">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid var(--color-subtle-border); padding-bottom: 0.5rem;">
            <span style="font-weight: 800; text-transform: uppercase; font-size: 0.9rem;">
              {{ 'collections.general.filter_by' | t }}
            </span>
            <a href="{{ collection.url }}" style="font-size: 0.8rem; text-decoration: underline; color: var(--color-accent);">
              {{ 'collections.general.clear_all' | t }}
            </a>
          </div>

          {%- for filter in collection.filters -%}
            <div class="filter-group">
              <div class="filter-group__title">{{ filter.label }}</div>

              {%- case filter.type -%}
                {%- when 'list', 'boolean' -%}
                  <ul class="filter-list">
                    {%- for value in filter.values -%}
                      <li>
                        <label class="filter-checkbox-label">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span>{{ value.label }} ({{ value.count }})</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>

                {%- when 'price_range' -%}
                  <div style="display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem;">
                    <input
                      type="number"
                      name="{{ filter.min_value.param_name }}"
                      placeholder="Min"
                      min="0"
                      max="{{ filter.range_max | divided_by: 100 }}"
                      value="{{ filter.min_value.value | divided_by: 100 }}"
                      style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--color-borders); border-radius: 4px;"
                    >
                    <span>-</span>
                    <input
                      type="number"
                      name="{{ filter.max_value.param_name }}"
                      placeholder="Max"
                      min="0"
                      max="{{ filter.range_max | divided_by: 100 }}"
                      value="{{ filter.max_value.value | divided_by: 100 }}"
                      style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--color-borders); border-radius: 4px;"
                    >
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}

          <noscript>
            <button type="submit" class="btn btn--secondary btn--full" style="margin-top: 1rem;">
              {{ 'collections.general.apply' | t }}
            </button>
          </noscript>
        </form>
      </aside>

      {%- comment -%} Product Grid & Toolbar {%- endcomment -%}
      <div>
        <div class="collection-toolbar">
          <div style="font-size: 0.95rem; font-weight: 600;">
            {{ 'collections.general.results_with_count' | t: count: collection.products_count }}
          </div>

          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <label for="CollectionSortBy" style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase;">
              {{ 'collections.general.sort_by' | t }}:
            </label>
            <select id="CollectionSortBy" class="sort-select" data-collection-sort>
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              <option value="manual" {% if sort_by == 'manual' %}selected{% endif %}>{{ 'collections.sorting.featured' | t }}</option>
              <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>{{ 'collections.sorting.best_selling' | t }}</option>
              <option value="title-ascending" {% if sort_by == 'title-ascending' %}selected{% endif %}>{{ 'collections.sorting.alphabetically_a_z' | t }}</option>
              <option value="title-descending" {% if sort_by == 'title-descending' %}selected{% endif %}>{{ 'collections.sorting.alphabetically_z_a' | t }}</option>
              <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>{{ 'collections.sorting.price_low_to_high' | t }}</option>
              <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>{{ 'collections.sorting.price_high_to_low' | t }}</option>
              <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>{{ 'collections.sorting.date_new_to_old' | t }}</option>
            </select>
          </div>
        </div>

        {%- if collection.products.size > 0 -%}
          <div class="products-grid">
            {%- for product in collection.products -%}
              {% render 'product-card',
                product: product,
                show_vendor: section.settings.show_vendor,
                show_quick_add: section.settings.show_quick_add
              %}
            {%- endfor -%}
          </div>

          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="empty-state">
            <h3>{{ 'collections.general.empty' | t }}</h3>
            <p style="color: var(--color-text-secondary); margin: 0.75rem 0 1.5rem;">
              Try clearing some filters or browse our other handcrafted collections.
            </p>
            <a href="/collections" class="btn btn--primary">
              {{ 'collections.general.continue_shopping' | t }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Enable quick add button",
      "default": true
    }
  ]
}
{% endschema %}
