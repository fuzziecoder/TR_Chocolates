<section class="section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-header-row">
      <div>
        {%- if section.settings.subheading != blank -%}
          <span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); display: block; margin-bottom: 0.5rem;">
            {{ section.settings.subheading | escape }}
          </span>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      </div>

      {%- if section.settings.show_all_link and section.settings.all_link != blank -%}
        <a href="{{ section.settings.all_link }}" class="category-shop-all-btn">
          {{ section.settings.all_link_text | default: 'SHOP ALL' }}
        </a>
      {%- endif -%}
    </div>

    <div class="collection-tiles-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign collection = collections[block.settings.collection] -%}
          {% render 'collection-tile',
            collection: collection,
            custom_title: block.settings.title,
            custom_image: block.settings.image
          %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default display matching artisan showcase {%- endcomment -%}
        {% render 'collection-tile', collection: collections['chocolate'], custom_title: 'Mini Bars' %}
        {% render 'collection-tile', collection: collections['pantry'], custom_title: 'Limited-Batch' %}
        {% render 'collection-tile', collection: collections['chocolate'], custom_title: 'Chocolate Bars' %}
        {% render 'collection-tile', collection: collections['herbal-traditional-care'], custom_title: 'Herbal Care' %}
        {% render 'collection-tile', collection: collections['bath-body'], custom_title: 'Bath & Body' %}
        {% render 'collection-tile', collection: collections['face-care'], custom_title: 'Face Care' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection List",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Handcrafted Artisanal Reserves"
    },
    {
      "type": "checkbox",
      "id": "show_all_link",
      "label": "Show 'Shop All' Button",
      "default": true
    },
    {
      "type": "text",
      "id": "all_link_text",
      "label": "'Shop All' Button Text",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "all_link",
      "label": "'Shop All' Link",
      "default": "/collections"
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image Override",
          "info": "Leave blank to use collection featured image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List",
      "blocks": [
        { "type": "collection_block", "settings": { "title": "Chocolate" } },
        { "type": "collection_block", "settings": { "title": "Pantry" } },
        { "type": "collection_block", "settings": { "title": "Herbal & Traditional Care" } },
        { "type": "collection_block", "settings": { "title": "Bath & Body" } },
        { "type": "collection_block", "settings": { "title": "Face Care" } },
        { "type": "collection_block", "settings": { "title": "Hair Care" } }
      ]
    }
  ]
}
{% endschema %}
