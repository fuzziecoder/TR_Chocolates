{%- paginate search.results by 16 -%}
  <div class="page-width section-spacing" data-section-id="{{ section.id }}">
    {% render 'breadcrumbs' %}

    <div style="text-align: center; max-width: 680px; margin: 0 auto 3rem;">
      <h1 style="font-size: 2.75rem; margin-bottom: 1.5rem;">
        {%- if search.performed -%}
          {{ 'collections.general.results_with_count' | t: count: search.results_count }} for &ldquo;{{ search.terms | escape }}&rdquo;
        {%- else -%}
          {{ 'general.search' | t }}
        {%- endif -%}
      </h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form-full">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search_placeholder' | t }}"
          class="search-input-full"
          aria-label="{{ 'general.search' | t }}"
        >
        <button type="submit" class="btn btn--primary">
          {{ 'general.search' | t }}
        </button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <div class="products-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, show_vendor: true, show_quick_add: true %}
            {%- else -%}
              <div class="product-card" style="padding: 1.5rem;">
                <span style="font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: var(--color-accent); margin-bottom: 0.5rem; display: block;">
                  {{ item.object_type | capitalize }}
                </span>
                <h3 class="product-card__title">
                  <a href="{{ item.url }}">{{ item.title }}</a>
                </h3>
                <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin-top: 0.5rem;">
                  {{ item.content | strip_html | truncatewords: 25 }}
                </p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          <h3>No results found for &ldquo;{{ search.terms | escape }}&rdquo;</h3>
          <p style="color: var(--color-text-secondary); margin: 0.75rem 0 1.5rem;">
            Check your spelling or try searching for chocolate, tea, honey, or botanical care.
          </p>
          <a href="/collections" class="btn btn--primary">
            {{ 'collections.general.continue_shopping' | t }}
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
