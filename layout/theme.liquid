<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,400&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- style -%}
      :root {
        --color-bg-main: {{ settings.color_bg_main | default: '#F8F5EE' }};
        --color-bg-surface: {{ settings.color_bg_surface | default: '#FFFFFF' }};
        --color-text-primary: {{ settings.color_text_primary | default: '#24150E' }};
        --color-text-secondary: {{ settings.color_text_secondary | default: '#68544A' }};
        --color-accent: {{ settings.color_accent | default: '#C86A58' }};
        --color-accent-hover: {{ settings.color_accent_hover | default: '#B25342' }};
        --color-secondary-accent: {{ settings.color_secondary_accent | default: '#5A6F54' }};
        --color-borders: {{ settings.color_borders | default: '#24150E' }};
        --color-badge-soldout-bg: {{ settings.color_badge_soldout_bg | default: '#7A736E' }};
        --color-badge-sale-bg: {{ settings.color_badge_sale_bg | default: '#C86A58' }};
        --page-width: {{ settings.page_width | default: 1320 }}px;
        --button-radius: {{ settings.button_radius | default: 6 }}px;
        --card-radius: {{ settings.card_radius | default: 16 }}px;
        --font-body-scale: {{ settings.font_body_scale | default: 100 | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.font_heading_scale | default: 105 | divided_by: 100.0 }};
      }
    {%- endstyle -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body>
    <a class="skip-to-content-link" href="#MainContent">
      {{ 'general.skip_to_content' | t }}
    </a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    {% render 'mobile-drawer' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
  </body>
</html>
