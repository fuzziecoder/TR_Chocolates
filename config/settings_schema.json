[
  {
    "name": "theme_info",
    "theme_name": "TR Artisan Reserve",
    "theme_version": "1.0.0",
    "theme_author": "Antigravity Theme Lab",
    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg_main",
        "label": "Background (Cream Base)",
        "default": "#F8F5EE"
      },
      {
        "type": "color",
        "id": "color_bg_surface",
        "label": "Card & Surface Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text_primary",
        "label": "Primary Text & Headings",
        "default": "#24150E"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Secondary Muted Text",
        "default": "#68544A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Primary Artisan Accent (Terracotta / Crimson)",
        "default": "#C86A58"
      },
      {
        "type": "color",
        "id": "color_accent_hover",
        "label": "Accent Hover",
        "default": "#B25342"
      },
      {
        "type": "color",
        "id": "color_secondary_accent",
        "label": "Botanical Sage Accent",
        "default": "#5A6F54"
      },
      {
        "type": "color",
        "id": "color_borders",
        "label": "Border & Outline Color",
        "default": "#24150E"
      },
      {
        "type": "color",
        "id": "color_badge_soldout_bg",
        "label": "Sold Out Badge Background",
        "default": "#7A736E"
      },
      {
        "type": "color",
        "id": "color_badge_sale_bg",
        "label": "Sale Badge Background",
        "default": "#C86A58"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "playfair_display_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body Font Scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading Font Scale",
        "default": 105
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "default": 1320,
        "unit": "px",
        "label": "Maximum Page Width"
      },
      {
        "type": "range",
        "id": "grid_horizontal_space",
        "min": 12,
        "max": 40,
        "step": 4,
        "default": 24,
        "unit": "px",
        "label": "Grid Horizontal Spacing"
      }
    ]
  },
  {
    "name": "Buttons & Cards",
    "settings": [
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "default": 6,
        "unit": "px",
        "label": "Button Border Radius"
      },
      {
        "type": "checkbox",
        "id": "button_offset_shadow",
        "label": "Enable Artisan Offset Box Shadow (Retro Craft Style)",
        "default": true
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "default": 16,
        "unit": "px",
        "label": "Collection & Product Card Radius"
      }
    ]
  },
  {
    "name": "Brand & Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 300,
        "step": 10,
        "default": 160,
        "unit": "px",
        "label": "Desktop Logo Width"
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 40,
        "max": 200,
        "step": 10,
        "default": 120,
        "unit": "px",
        "label": "Mobile Logo Width"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon Image",
        "info": "Recommended: 32 x 32px .png"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram Link"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook Link"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest Link"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube Link"
      }
    ]
  }
]
