{% comment %}
  Renders the "Visit" Mega Menu dropdown — TR Homemade Chocolates
  Layout (matches reference):
    Left (2 side-by-side cards) → Classes & Events, Find TR Near You
    Center                      → TR Homemade Chocolates, Hours, Address
    Right                       → Shop exterior building photo
{% endcomment %}

<div class="visit-menu-drawer" id="VisitMegaMenu" role="region" aria-label="Visit Menu">
  <div class="page-width visit-menu-inner">

    {%- comment -%} LEFT — 2 side-by-side cards {%- endcomment -%}
    <div class="visit-menu-cards">
      <a href="/pages/classes-events" class="visit-card">
        <div class="visit-card__img">
          <img
            src="https://images.unsplash.com/photo-1606312619070-d48b4c652a52?w=500&auto=format&fit=crop&q=80"
            alt="Classes & Events"
            loading="lazy"
          >
        </div>
        <span class="visit-card__title">Classes &amp; Events</span>
      </a>

      <a href="/pages/find-us" class="visit-card">
        <div class="visit-card__img">
          <img
            src="https://images.unsplash.com/photo-1549007994-cb92caebd54b?w=500&auto=format&fit=crop&q=80"
            alt="Find TR Near You"
            loading="lazy"
          >
        </div>
        <span class="visit-card__title">Find TR Near You</span>
      </a>
    </div>

    {%- comment -%} CENTER — Shop info {%- endcomment -%}
    <div class="visit-menu-info">
      <h3 class="visit-menu-info__name">TR Homemade Chocolates</h3>

      <div class="visit-menu-info__block">
        <span class="visit-menu-info__label">Hours</span>
        <div class="visit-menu-info__text">
          <div>Mon-Thu: 10 am – 8 pm</div>
          <div>Fri-Sun: 10 am – 9 pm</div>
        </div>
      </div>

      <div class="visit-menu-info__block">
        <span class="visit-menu-info__label">Address</span>
        <a href="https://maps.google.com/?q=Annamalai+Nagar+Hosur+635126" target="_blank" rel="noopener" class="visit-menu-info__address">
          <div>Annamalai Nagar, Hosur</div>
          <div>635126</div>
        </a>
      </div>
    </div>

    {%- comment -%} RIGHT — Shop exterior photo {%- endcomment -%}
    <div class="visit-menu-photo">
      <img
        src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=600&auto=format&fit=crop&q=80"
        alt="TR Homemade Chocolates Shop Front"
        loading="lazy"
      >
    </div>

  </div>
</div>
