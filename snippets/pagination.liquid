{% comment %}
  Renders accessible pagination.
  Accepts:
  - paginate: {Object} Shopify paginate object
{% endcomment %}

{%- if paginate.parts.size > 0 -%}
  <nav class="pagination-wrapper" role="navigation" aria-label="Pagination">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="pagination-page" aria-label="Previous page">
        &lsaquo;
      </a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="pagination-page" aria-label="Page {{ part.title }}">
          {{ part.title }}
        </a>
      {%- else -%}
        {%- if part.title == paginate.current_page -%}
          <span class="pagination-page is-current" aria-current="page">
            {{ part.title }}
          </span>
        {%- else -%}
          <span class="pagination-page" style="border: none; box-shadow: none;">{{ part.title }}</span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="pagination-page" aria-label="Next page">
        &rsaquo;
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
