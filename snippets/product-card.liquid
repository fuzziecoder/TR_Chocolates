{% comment %}
  Renders a product card in a collection or featured grid.
  Accepts:
  - product: {Object} Shopify Product object
  - show_vendor: {Boolean} Whether to display vendor
  - show_quick_add: {Boolean} Whether to show an add-to-cart button

  Usage:
  {% render 'product-card', product: product, show_vendor: true %}
{% endcomment %}

{%- liquid
  assign featured_media = product.featured_media
  assign second_media = product.media[1]
  assign sold_out = false
  if product.available == false
    assign sold_out = true
  endif

  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<div class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__media">
    {%- if sold_out -%}
      <span class="product-badge product-badge--soldout">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif on_sale -%}
      <span class="product-badge product-badge--sale">{{ 'products.product.sale_price' | t }}</span>
    {%- endif -%}

    <a href="{{ product.url }}" class="product-card__media-link" aria-label="{{ product.title | escape }}">
      {%- if featured_media != blank -%}
        {{
          featured_media
          | image_url: width: 600
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw',
            widths: '240, 360, 480, 600, 720',
            alt: featured_media.alt | default: product.title | escape,
            class: 'product-card__img-main'
        }}
      {%- else -%}
        <div style="background: #EFE8DC; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; min-height: 220px;">
          {% render 'icon', name: 'cart' %}
        </div>
      {%- endif -%}
    </a>
  </div>

  <div class="product-card__details">
    {%- if show_vendor and product.vendor != blank -%}
      <div class="product-card__vendor">{{ product.vendor }}</div>
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    {% render 'price', product: product %}

    {%- if show_quick_add and product.available -%}
      <div class="product-card__footer">
        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" name="add" class="btn btn--secondary btn--full" style="padding: 0.5rem; font-size: 0.85rem;">
            {{ 'products.product.add_to_cart' | t }}
          </button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</div>
