{% comment %}
  Renders the "Contact" Mega Menu dropdown — TR Homemade Chocolates
  Matches the artisan warm chocolate theme (#4A2612, caramel accents, 32px radius)
{% endcomment %}

<div class="contact-menu-drawer" id="ContactMegaMenu" role="region" aria-label="Contact Menu">
  <div class="page-width contact-menu-inner">

    {%- comment -%} COLUMN 1: Direct Contact Channels {%- endcomment -%}
    <div class="contact-menu-col contact-menu-channels">
      <h3 class="contact-menu-heading">Get in Touch</h3>
      <p class="contact-menu-subtext">Have a question about our chocolates or custom gift hampers? We'd love to hear from you.</p>

      <div class="contact-channels-list">
        <a href="tel:+919876543210" class="contact-channel-item">
          <div class="contact-channel-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="contact-channel-content">
            <span class="contact-channel-label">Call Us</span>
            <span class="contact-channel-val">+91 98765 43210</span>
          </div>
        </a>

        <a href="mailto:hello@trchocolates.com" class="contact-channel-item">
          <div class="contact-channel-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <div class="contact-channel-content">
            <span class="contact-channel-label">Email Support</span>
            <span class="contact-channel-val">hello@trchocolates.com</span>
          </div>
        </a>

        <a href="https://wa.me/919876543210" target="_blank" rel="noopener" class="contact-channel-item">
          <div class="contact-channel-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
          <div class="contact-channel-content">
            <span class="contact-channel-label">WhatsApp Quick Chat</span>
            <span class="contact-channel-val">Instant Assistance</span>
          </div>
        </a>
      </div>
    </div>

    {%- comment -%} COLUMN 2: Specialized Inquiries & CTA Block {%- endcomment -%}
    <div class="contact-menu-col contact-menu-inquiries">
      <h3 class="contact-menu-heading">Special Inquiries</h3>
      
      <div class="contact-inquiry-links">
        <a href="/pages/wholesale" class="contact-inquiry-link">
          <span class="contact-inquiry-title">Corporate &amp; Bulk Orders</span>
          <span class="contact-inquiry-desc">Handcrafted corporate boxes and wholesale arrangements.</span>
        </a>

        <a href="/pages/custom-gifting" class="contact-inquiry-link">
          <span class="contact-inquiry-title">Weddings &amp; Celebrations</span>
          <span class="contact-inquiry-desc">Custom-labeled artisan bonbons and festival hampers.</span>
        </a>

        <a href="/pages/faq" class="contact-inquiry-link">
          <span class="contact-inquiry-title">Orders &amp; Shipping FAQ</span>
          <span class="contact-inquiry-desc">Answers to temperature-controlled shipping and delivery.</span>
        </a>
      </div>

      <div class="contact-menu-cta">
        <span class="contact-menu-cta__label">Need a Custom Quote?</span>
        <a href="/pages/contact#inquiry-form" class="contact-menu-cta__btn">Send Message</a>
      </div>
    </div>

    {%- comment -%} COLUMN 3: Factory Storefront & Hours {%- endcomment -%}
    <div class="contact-menu-col contact-menu-storefront">
      <div class="contact-storefront-card">
        <div class="contact-storefront-img">
          <img
            src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=500&auto=format&fit=crop&q=80"
            alt="TR Homemade Chocolates Storefront"
            loading="lazy"
          >
        </div>
        <div class="contact-storefront-body">
          <h4 class="contact-storefront-title">Hosur Boutique &amp; Kitchen</h4>
          <p class="contact-storefront-addr">Annamalai Nagar, Hosur, Tamil Nadu 635126</p>
          <div class="contact-storefront-timing">
            <span class="contact-timing-badge">Open Daily</span>
            <span>10:00 AM – 9:00 PM</span>
          </div>
          <a href="https://maps.google.com/?q=Annamalai+Nagar+Hosur+635126" target="_blank" rel="noopener" class="contact-storefront-maplink">
            Get Directions &rarr;
          </a>
        </div>
      </div>
    </div>

  </div>
</div>
