{% comment %}
  Renders the accessible off-canvas mobile navigation drawer
{% endcomment %}

<div class="mobile-nav-overlay" data-action="close-mobile-menu"></div>

<div class="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation" aria-hidden="true">
  <div class="mobile-nav-header">
    <span class="site-header__logo-text" style="font-size: 1.4rem;">
      {{ shop.name | default: 'TR Artisan' }}
    </span>
    <button type="button" class="header-icon-btn" data-action="close-mobile-menu" aria-label="{{ 'general.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" style="margin-bottom: 1.5rem;">
    <div style="display: flex; gap: 0.5rem;">
      <input
        type="search"
        name="q"
        placeholder="{{ 'general.search_placeholder' | t }}"
        style="width: 100%; padding: 0.65rem 0.85rem; border: 2px solid var(--color-borders); border-radius: var(--button-radius); font-size: 0.9rem;"
      >
      <button type="submit" class="btn btn--primary" style="padding: 0.65rem 1rem;" aria-label="{{ 'general.search' | t }}">
        {% render 'icon', name: 'search' %}
      </button>
    </div>
  </form>

  <ul class="mobile-nav-list">
    <li class="mobile-nav-item">
      <a href="{{ routes.root_url }}" class="mobile-nav-link">{{ 'general.breadcrumbs.home' | t }}</a>
    </li>

    <li class="mobile-nav-item">
      <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(36, 21, 14, 0.06);">
        <a href="/collections" class="mobile-nav-link" style="border-bottom: none; flex-grow: 1;">Shop</a>
        <button type="button" class="mobile-submenu-toggle" aria-expanded="false" style="background: none; border: none; padding: 0.75rem; cursor: pointer;">
          {% render 'icon', name: 'chevron-down' %}
        </button>
      </div>

      <ul class="mobile-nav-submenu">
        <li><a href="/collections/chocolate" class="mobile-nav-sublink">Chocolate</a></li>
        <li><a href="/collections/pantry" class="mobile-nav-sublink">Pantry</a></li>
        <li><a href="/collections/herbal-traditional-care" class="mobile-nav-sublink">Herbal & Traditional Care</a></li>
        <li><a href="/collections/bath-body" class="mobile-nav-sublink">Bath & Body</a></li>
        <li><a href="/collections/face-care" class="mobile-nav-sublink">Face Care</a></li>
        <li><a href="/collections/hair-care" class="mobile-nav-sublink">Hair Care</a></li>
        <li><a href="/collections" class="mobile-nav-sublink" style="font-weight: 700; color: var(--color-accent);">{{ 'header.shop_all' | t }} &rarr;</a></li>
      </ul>
    </li>

    <li class="mobile-nav-item">
      <a href="/pages/our-story" class="mobile-nav-link">Our Story</a>
    </li>

    <li class="mobile-nav-item">
      <a href="/pages/contact" class="mobile-nav-link">Contact</a>
    </li>

    {%- if shop.customer_accounts_enabled -%}
      <li class="mobile-nav-item" style="margin-top: 1rem;">
        <a href="{{ routes.account_url }}" class="mobile-nav-link">
          {% render 'icon', name: 'account' %}
          <span style="margin-left: 0.5rem;">{{ 'header.account' | t }}</span>
        </a>
      </li>
    {%- endif -%}
  </ul>
</div>
