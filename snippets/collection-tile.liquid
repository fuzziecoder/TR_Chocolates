{% comment %}
  Renders an artisan collection tile matching the Raaka-inspired rounded card layout.
  Accepts:
  - collection: {Object} Shopify Collection object
  - custom_title: {String} Override title if specified
  - custom_image: {Object} Override image if specified
{% endcomment %}

{%- liquid
  assign title = custom_title | default: collection.title
  assign image = custom_image | default: collection.featured_image
  assign url = collection.url | default: '#'
-%}

<a href="{{ url }}" class="collection-tile" aria-label="{{ title | escape }}">
  <div class="collection-tile__media-container">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 1200px) 33vw, (min-width: 768px) 50vw, 100vw',
          widths: '300, 400, 600',
          alt: image.alt | default: title | escape
      }}
    {%- else -%}
      <img
        src="https://images.unsplash.com/photo-1548907040-4baa42d10919?w=500&auto=format&fit=crop&q=80"
        alt="{{ title | escape }}"
        loading="lazy"
        width="400"
        height="400"
      >
    {%- endif -%}
  </div>

  <div class="collection-tile__info">
    <span class="collection-tile__title">{{ title }}</span>
    <span class="collection-tile__arrow" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </span>
  </div>
</a>
