{% comment %}
  Renders a responsive image with srcset and proper loading attributes.
  Accepts:
  - image: {Object} Shopify Image object
  - alt: {String} Alternative text (optional)
  - class: {String} Additional CSS classes (optional)
  - sizes: {String} Sizes attribute (optional)
  - priority: {String} 'eager' or 'lazy' (default: 'lazy')
  - widths: {Array} Widths for srcset (optional)

  Usage:
  {% render 'responsive-image', image: section.settings.image, alt: section.settings.heading, priority: 'eager' %}
{% endcomment %}

{%- liquid
  assign loading_attr = priority | default: 'lazy'
  assign image_alt = alt | default: image.alt | escape
  assign image_widths = '180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048'
  assign default_sizes = sizes | default: '(min-width: 1200px) 1100px, (min-width: 768px) 720px, 100vw'
-%}

{%- if image != blank -%}
  {{
    image
    | image_url: width: 1500
    | image_tag:
      loading: loading_attr,
      fetchpriority: priority == 'eager' ? 'high' : 'auto',
      sizes: default_sizes,
      widths: image_widths,
      alt: image_alt,
      class: class
  }}
{%- else -%}
  <div class="placeholder-image-wrapper {{ class }}" style="background: #EFE8DC; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center;">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent); opacity: 0.6;">
      <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
      <circle cx="9" cy="9" r="2"/>
      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
    </svg>
  </div>
{%- endif -%}
